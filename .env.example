# ── 로컬 개발 (npm run db:local 로 띄운 PGlite 서버) ──
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# PGlite 소켓 서버는 연결을 다중화하므로 모든 쿼리를 트랜잭션으로 감싼다. 운영 PostgreSQL 에서는 0.
DB_FORCE_TX=1

# 복구 코드·기기 토큰 HMAC 키. 운영에서는 32바이트 이상 임의 문자열로 반드시 교체.
APP_SECRET=change-me-local-dev-secret-0123456789abcdef

# 관리자 API(/api/admin/*) Bearer 토큰. 비워 두면 관리자 API 비활성(CLI 만 사용).
ADMIN_TOKEN=

# 학생용 URL 출력에 쓰는 공개 주소 (카톡 공유 링크의 앞부분)
PUBLIC_BASE_URL=http://localhost:3000

# ── 운영 예시 ──
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/vocaquest?sslmode=require
# DB_FORCE_TX=0
